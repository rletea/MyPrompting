# Teleprompter — environment variables
# Copy to .env and fill in real values before running locally.

# HTTP port (Railway sets this automatically)
PORT=3000

# Node environment: 'development' or 'production'
# In production: session cookie is secure (HTTPS only)
NODE_ENV=development

# REQUIRED: Secret used to sign session cookies.
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
SESSION_SECRET=replace-with-a-long-random-secret
